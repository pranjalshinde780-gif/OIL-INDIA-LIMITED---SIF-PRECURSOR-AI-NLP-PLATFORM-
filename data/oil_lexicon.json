  "iogp_rules": {
    "Bypassing Safety Controls": {
      "keywords": ["bypass", "interlock", "overrode", "disabled", "bridged", "safety switch", "trip bypassed", "tampered", "alarm muted", "esdv inhibited", "safety guard removed"],
      "description": "Obtain authorization before overriding or disabling safety controls or critical alarms."
    },
    "Confined Space": {
      "keywords": ["confined space", "tank entry", "mud tank", "separator vessel", "manhole", "inside column", "sump", "oxygen deficient", "atmospheric test", "standby person", "internal cleaning"],
      "description": "Obtain authorization before entering a confined space; verify atmospheric gas test and standby watch."
    },
    "Driving": {
      "keywords": ["seatbelt", "speeding", "rollover", "driver distraction", "heavy vehicle", "truck", "tanker trailer", "crane transit", "fatigue", "journey management", "oilfield road"],
      "description": "Follow safe driving rules: wear seatbelts, obey speed limits, do not use mobile phones, rest properly."
    },
    "Energy Isolation": {
      "keywords": ["loto", "lockout", "tagout", "isolation", "blind flange", "residual pressure", "live circuit", "energized", "depressurize", "breaker unlocked", "valve passing"],
      "description": "Verify isolation and zero energy state before work begins on energized, pressurized, or electrical systems."
    },
    "Hot Work": {
      "keywords": ["hot work", "welding", "cutting torch", "grinding sparks", "flammable atmosphere", "gas test", "fire watch", "spark arrestor", "hydrocarbon area", "habitat"],
      "description": "Control flammables and ignition sources. Obtain permit and continuous gas monitoring in hazardous zones."
    },
    "Line of Fire": {
      "keywords": ["line of fire", "pinch point", "crushing", "struck by", "pressurized line", "high pressure hose", "whip check", "rotating equipment", "iron roughneck", "cathead", "rotary table"],
      "description": "Keep yourself and others out of the line of fire of moving equipment, suspended loads, and pressurized systems."
    },
    "Safe Mechanical Lifting": {
      "keywords": ["crane", "lifting", "rigging", "hoisting", "suspended load", "sling damaged", "shackle", "drop zone", "banksman", "tag line", "overload", "winch wire"],
      "description": "Plan lifting operations and control the area. Never walk or position yourself under a suspended load."
    },
    "Toxic Gas & Hazardous Atmosphere": {
      "keywords": ["h2s", "toxic gas", "sour gas", "gas leak", "hydrocarbon leak", "scba", "gas detector", "benzene", "mercaptan", "sulfur dioxide", "plume", "breathing apparatus"],
      "description": "Wear personal gas detector, know escape routes, carry SCBA in designated sour gas and hazardous zones."
    },
    "Working at Height": {
      "keywords": ["working at height", "derrick", "monkey board", "harness", "lanyard", "fall arrest", "scaffolding", "green tag", "toe board", "man basket", "100% tie off", "open grating"],
      "description": "Protect yourself against falling when working at height (above 1.8m). Inspect scaffolding and tie off 100%."
    },
    "Work Authorization & Permit to Work": {
      "keywords": ["permit to work", "ptw", "authorization", "unauthorized work", "jha missing", "risk assessment", "expired permit", "toolbox talk", "toolbox meeting"],
      "description": "Work with a valid permit when required; understand scope and critical controls before commencing."
    }
  },
  "high_energy_hazards": {
    "gravitational": {
      "indicators": ["height", "elevation", "derrick", "monkey board", "mast", "ladder", "scaffold", "suspended load", "falling object", "dropped object", "crane hook"],
      "threshold_hint": "> 1.8 meters or heavy dropped load"
    },
    "high_pressure": {
      "indicators": ["psi", "bar", "high pressure", "hydrotest", "blowout", "bop", "choke manifold", "mud pump", "discharge line", "coiled tubing", "flange leak"],
      "threshold_hint": "> 100 psi or hydraulic line"
    },
    "toxic_chemical": {
      "indicators": ["h2s", "sour gas", "hydrocarbon gas", "crude spray", "condensate", "acidizing", "caustic", "benzene", "flammable vapor"],
      "threshold_hint": "Lethal concentration or asphyxiation risk"
    },
    "electrical": {
      "indicators": ["high voltage", "440v", "11kv", "33kv", "transformer", "switchgear", "substation", "bare wire", "arc flash"],
      "threshold_hint": "> 50V AC / Industrial switchgear"
    },
    "mechanical_kinetic": {
      "indicators": ["rotary table", "top drive", "drawworks", "cathead", "conveyor", "heavy vehicle", "mud agitator", "compressor flywheel"],
      "threshold_hint": "Unguarded rotating equipment or moving industrial plant"
    }
  },
  "barrier_indicators": {
